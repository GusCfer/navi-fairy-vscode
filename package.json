{
  "name": "navi-pet-english",
  "displayName": "Navi Fairy Pet",
  "description": "A pixel-art fairy that flies around the Explorer like a pet and reacts to your code.",
  "version": "1.0.1",
  "publisher": "guscfer",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/melon-juice/navi-fairy-vscode-english"
  },
  "bugs": {
    "url": "https://github.com/GusCfer/navi-fairy-vscode-english/issues"
  },
  "homepage": "https://github.com/GusCfer/navi-fairy-vscode-english#readme",
  "engines": {
    "vscode": "^1.93.0"
  },
  "categories": [
    "Other"
  ],
  "main": "./extension.js",
  "activationEvents": [
    "onStartupFinished"
  ],
  "contributes": {
    "views": {
      "explorer": [
        {
          "type": "webview",
          "id": "fadaPet.view",
          "name": "Navi",
          "icon": "icon.png"
        }
      ]
    },
    "commands": [
      {
        "command": "fadaPet.chamar",
        "title": "Navi: Call the fairy"
      },
      {
        "command": "fadaPet.trocarCor",
        "title": "Navi: Change colour"
      }
    ],
    "configuration": {
      "title": "Navi",
      "properties": {
        "fadaPet.cor": {
          "type": "string",
          "enum": [
            "azul",
            "verde",
            "rosa",
            "amarela",
            "roxa"
          ],
          "default": "azul",
          "description": "Fairy shimmer colour"
        },
        "fadaPet.tamanho": {
          "type": "number",
          "enum": [
            2,
            3,
            4,
            5
          ],
          "default": 3,
          "description": "Size of each pixel (pixel art scale)"
        },
        "fadaPet.frase": {
          "type": "string",
          "default": "Hey! Listen!",
          "description": "What Navi says when you click on her and from time to time"
        },
        "fadaPet.reagirErros": {
          "type": "boolean",
          "default": true,
          "description": "The fairy notifies you when the file open in editor contains errors"
        },
        "fadaPet.dicas": {
          "type": "boolean",
          "default": true,
          "description": "The fairy says random phrases from time to time"
        }
      }
    }
  },
  "icon": "icon.png",
  "keywords": [
    "pet",
    "fairy",
    "fada",
    "pixel art",
    "companion"
  ]
}
