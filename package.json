{
  "name": "navi-pet-english",
  "displayName": "Navi Fairy Pet",
  "description": "This extension lets Navi the fairy - from Legend of Zelda - fly around and react to your code! She'll respond to your interactions as you code; her comments are supportive, helpful and -sometimes- a little sassy!",
  "version": "1.0.1",
  "author": "melon-juice",
  "publisher": "melon-juice",
  "contributors": ["guscfer"],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/melon-juice/navi-fairy-vscode-english"
  },
  "bugs": {
    "url": "https://github.com/GusCfer/navi-fairy-vscode-english/issues"
  },
  "homepage": "https://github.com/GusCfer/navi-fairy-vscode-english#readme",
  "engines": {
    "vscode": "^1.93.0"
  },
  "categories": [
    "Other"
  ],
  "main": "./extension.js",
  "activationEvents": [
    "onStartupFinished"
  ],
  "contributes": {
    "views": {
      "explorer": [
        {
          "type": "webview",
          "id": "navi_the_fairy.view",
          "name": "Navi",
          "icon": "icon.png"
        }
      ]
    },
    "commands": [
      {
        "command": "navi_the_fairy.call",
        "title": "Navi: Call the fairy"
      },
      {
        "command": "navi_the_fairy.changeColour",
        "title": "Navi: Change colour"
      }
    ],
    "configuration": {
      "title": "Navi",
      "properties": {
        "navi_the_fairy.colour": {
          "type": "string",
          "enum": [
            "blue",
            "green",
            "pink",
            "yellow",
            "purple"
          ],
          "default": "blue",
          "description": "Sparkle colour"
        },
        "navi_the_fairy.size": {
          "type": "number",
          "enum": [
            2,
            3,
            4,
            5
          ],
          "default": 3,
          "description": "Size of each pixel (pixel art scale)"
        },
        "navi_the_fairy.phrase": {
          "type": "string",
          "default": "Hey! Listen!",
          "description": "What Navi says when you click on her and from time to time"
        },
        "navi_the_fairy.reactToErrors": {
          "type": "boolean",
          "default": true,
          "description": "The fairy notifies you when the file open in editor contains errors"
        },
        "navi_the_fairy.tips": {
          "type": "boolean",
          "default": true,
          "description": "The fairy says random phrases from time to time"
        }
      }
    }
  },
  "icon": "icon.png",
  "keywords": [
    "pet",
    "fairy",
    "navi",
    "zelda",
    "cute",
    "whimsical",
    "pixel art",
    "companion"
  ]
}
